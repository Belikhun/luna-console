# Shared by both compose files — copy to .env beside them.

# Generated once with `luna daemon token`, identical on every daemon in the
# cluster. A follower without it cannot authenticate; a primary without it
# cannot accept one.
LUNA_TOKEN=

# Daemon name: keys cluster.json and decides instance ownership, so it must be
# unique across the cluster and stable across restarts. Defaults to the
# container's hostname, which docker regenerates — set it explicitly.
LUNA_DAEMON_NAME=primary

# --- follower only -----------------------------------------------------------

# host:port of the primary's cluster listener
LUNA_PRIMARY_ADDRESS=10.0.0.10:8331

# LAN address the primary routes this machine's backends to. Leave empty to let
# the primary use the address it sees the follower connect from.
LUNA_HOST=

# --- primary only ------------------------------------------------------------

# Interface the console binds to on the host. Keep it on loopback and put a
# reverse proxy in front unless the network is trusted.
CONSOLE_BIND=127.0.0.1
